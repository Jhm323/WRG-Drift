DATABASE_URL="postgresql://youruser@localhost:5432/dirtcar_drift_dev?schema=public"
PORT=4000

JWT_SECRET="generate-a-long-random-string"

# HMAC key for Run.serverChecksum (anti-cheat, build plan §7) — separate from
# JWT_SECRET on purpose, so rotating one doesn't invalidate the other.
SCORE_HMAC_SECRET="generate-a-long-random-string"

# Leave unset in dev — the email service logs the verification/reset link
# to the console instead of sending a real email.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="DirtCar Drift <onboarding@resend.dev>"

# TEMP: set to "true" to skip email verification at signup/login — blocked on
# dirtcar.com DNS access, see [ticket/note]. Leave unset once DNS is sorted.
SKIP_EMAIL_VERIFICATION=""

API_BASE_URL="http://localhost:4000"
WEB_BASE_URL="http://localhost:5173"

# Leave unset in dev — the weekly/monthly podium announcement is logged to
# the console instead of posted to Slack.
SLACK_WEBHOOK_URL=""
