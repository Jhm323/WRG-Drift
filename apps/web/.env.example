# Leave unset for local dev — relative /auth and /api paths go through the
# Vite dev server proxy (see vite.config.js) to the API on localhost:4000.
#
# Required in production (Vercel): the deployed API's URL, since the
# frontend and API are on different domains there (Vercel + Render) and
# there's no dev-server proxy to lean on.
VITE_API_BASE_URL="https://your-api.onrender.com"
